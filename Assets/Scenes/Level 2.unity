    - target: {fileID: 4139366882888764315, guid: 72d7b3b79c13fdd4f92e7a8aedb2e394, type: 3}
      propertyPath: beforeWaterQuestDialogue.lines.Array.data[2].portrait
      value: 
      objectReference: {fileID: 21300000, guid: 26fd4351cebb11442be4e121cb44d59e, type: 3}
    - target: {fileID: 4139366882888764315, guid: 72d7b3b79c13fdd4f92e7a8aedb2e394, type: 3}
